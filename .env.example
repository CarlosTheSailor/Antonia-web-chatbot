PORT=3000
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_SYSTEM_PROMPT=Eres un asistente para una web de negocio. Responde en español de forma clara y breve.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Integracion oficial Aimharder (booking guest)
AIMHARDER_ENABLED=false
AIMHARDER_BASE_URL=https://api.aimharder.com
AIMHARDER_ACCESS_TOKEN=
AIMHARDER_REFRESH_TOKEN=
AIMHARDER_TOKEN_REFRESH_PATH=/auth/tokens/refresh
AIMHARDER_BOOKING_GUEST_PATH=/classes/booking/guest
AIMHARDER_TIMEOUT_MS=10000
# person_id puede ser requerido por la API para crear booking guest
AIMHARDER_PERSON_ID=
# Mapa schedule_id por franja, JSON string:
# {"1|07:00":555,"3|19:00|funcional":777}
AIMHARDER_SCHEDULE_MAP_JSON=

# Integracion WhatsApp (aviso a coaches)
# Recomendada via webhook propio (Make/Zapier/backend) que postee al grupo de coaches.
WHATSAPP_ENABLED=false
WHATSAPP_WEBHOOK_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_COACH_GROUP_ID=
